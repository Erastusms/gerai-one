datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  clerkId            String?    @unique @map("clerk_id")
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  fullName           String?    @map("full_name")
  imageUrl           String?    @map("image_url")
  phoneNumber        String?    @map("phone_number")
  username           String?    @unique
  gender             String?
  dateOfBirth        DateTime?  @map("date_of_birth") @db.Date
  profilePhoto       String?    @map("profile_photo")
  isProfileCompleted Boolean    @default(false) @map("is_profile_completed")
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  reviews            Review[]
  wishlists          Wishlist[]
  cart               Cart?
  checkoutSessions   CheckoutSession[]
  addresses          Address[]
  adminLoginLogs     AdminLoginLog[]

  @@map("users")
}

model AdminLoginLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  identifier String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  status     String
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("admin_login_logs")
}

model Address {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  label          String // Home, Office, Apartment, Other
  recipientName  String    @map("recipient_name")
  recipientPhone String    @map("recipient_phone")
  province       String
  city           String
  district       String
  subDistrict    String    @map("sub_district")
  postalCode     String    @map("postal_code")
  fullAddress    String    @map("full_address") @db.Text
  notes          String?   @db.Text
  isDefault      Boolean   @default(false) @map("is_default")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@map("addresses")
}


model Category {
  id          String            @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String            @unique
  description String?           @db.Text
  imageUrl    String?           @map("image_url")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  
  products    ProductCategory[]

  @@index([name])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  products  Product[]

  @@index([slug])
  @@index([name])
  @@map("brands")
}

model Product {
  id               String                 @id @default(uuid(7)) @db.Uuid
  sku              String                 @unique
  name             String
  slug             String                 @unique
  shortDescription String?                @map("short_description") @db.Text
  description      String?                @db.Text
  brandId          String?                @map("brand_id") @db.Uuid
  price            Decimal                @db.Decimal(12, 2)
  discountPrice    Decimal?               @map("discount_price") @db.Decimal(12, 2)
  weight           Float?
  thumbnailUrl     String?                @map("thumbnail_url")
  isActive         Boolean                @default(true) @map("is_active")
  isFeatured       Boolean                @default(false) @map("is_featured")
  viewCount        Int                    @default(0) @map("view_count")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")

  brand            Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  specifications   ProductSpecification[]
  categories       ProductCategory[]
  variants         ProductVariant[]
  seo              ProductSeo?
  reviews          Review[]
  wishlists        Wishlist[]

  @@index([name])
  @@index([createdAt])
  @@index([viewCount])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductSpecification {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  key       String
  value     String

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id            String    @id @default(uuid(7)) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  sku           String    @unique
  price         Decimal   @db.Decimal(12, 2)
  discountPrice Decimal?  @map("discount_price") @db.Decimal(12, 2)
  weight        Float?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]
  checkoutItems   CheckoutItem[]
  inventory       Inventory?

  @@index([productId])
  @@map("product_variants")
}

model Attribute {
  id        String           @id @default(uuid(7)) @db.Uuid
  name      String           @unique
  createdAt DateTime         @default(now()) @map("created_at")
  deletedAt DateTime?        @map("deleted_at")
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid(7)) @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  value       String
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([variantId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model ProductSeo {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @unique @map("product_id") @db.Uuid
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  seoKeywords    String?  @map("seo_keywords")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_seo")
}

model Review {
  id                 String    @id @default(uuid(7)) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  rating             Int
  comment            String?   @db.Text
  isVerifiedPurchase Boolean   @default(false) @map("is_verified_purchase")
  isHidden           Boolean   @default(false) @map("is_hidden")
  helpfulCount       Int       @default(0) @map("helpful_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model Cart {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id               String         @id @default(uuid(7)) @db.Uuid
  cartId           String         @map("cart_id") @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  quantity         Int            @default(1)
  isSelected       Boolean        @default(true) @map("is_selected")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
  @@map("cart_items")
}

enum InventoryMovementType {
  IN
  OUT
  RESERVE
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
}

model Inventory {
  id               String              @id @default(uuid(7)) @db.Uuid
  productVariantId String              @unique @map("product_variant_id") @db.Uuid
  availableStock   Int                 @default(0) @map("available_stock")
  reservedStock    Int                 @default(0) @map("reserved_stock")
  soldStock        Int                 @default(0) @map("sold_stock")
  damagedStock     Int                 @default(0) @map("damaged_stock")
  incomingStock    Int                 @default(0) @map("incoming_stock")
  safetyStock      Int                 @default(0) @map("safety_stock")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements        InventoryMovement[]

  @@map("inventories")
}

model InventoryMovement {
  id            String                @id @default(uuid(7)) @db.Uuid
  inventoryId   String                @map("inventory_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  referenceId   String?               @map("reference_id")
  referenceType String?               @map("reference_type")
  note          String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum CheckoutStatus {
  PENDING
  EXPIRED
  COMPLETED
  CANCELLED
}

model CheckoutSession {
  id                     String         @id @default(uuid(7)) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  orderNumber            String         @unique @map("order_number")
  status                 CheckoutStatus @default(PENDING)
  expiresAt              DateTime       @map("expires_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  // Shipping Address Snapshot
  shippingLabel          String?        @map("shipping_label")
  shippingRecipientName  String?        @map("shipping_recipient_name")
  shippingRecipientPhone String?        @map("shipping_recipient_phone")
  shippingProvince       String?        @map("shipping_province")
  shippingCity           String?        @map("shipping_city")
  shippingDistrict       String?        @map("shipping_district")
  shippingSubDistrict    String?        @map("shipping_sub_district")
  shippingPostalCode     String?        @map("shipping_postal_code")
  shippingFullAddress    String?        @map("shipping_full_address") @db.Text
  shippingNotes          String?        @map("shipping_notes") @db.Text

  // Shipping Method Snapshot
  shippingServiceId          String?        @map("shipping_service_id") @db.Uuid
  shippingServiceName        String?        @map("shipping_service_name")
  shippingServiceDescription String?        @map("shipping_service_description") @db.Text
  shippingEstimatedDelivery  String?        @map("shipping_estimated_delivery")
  shippingFee                Decimal?       @map("shipping_fee") @db.Decimal(12, 2)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CheckoutItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("checkout_sessions")
}

model CheckoutItem {
  id                String          @id @default(uuid(7)) @db.Uuid
  checkoutSessionId String          @map("checkout_session_id") @db.Uuid
  productVariantId  String          @map("product_variant_id") @db.Uuid
  productName       String          @map("product_name")
  sku               String
  price             Decimal         @db.Decimal(12, 2)
  discountPrice     Decimal?        @map("discount_price") @db.Decimal(12, 2)
  quantity          Int
  thumbnailUrl      String?         @map("thumbnail_url")

  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([checkoutSessionId])
  @@map("checkout_items")
}

model ShippingService {
  id                      String   @id @default(uuid(7)) @db.Uuid
  code                    String   @unique
  name                    String
  description             String?  @db.Text
  estimatedDeliveryMinDay Int      @map("estimated_delivery_min_day")
  estimatedDeliveryMaxDay Int      @map("estimated_delivery_max_day")
  defaultPrice            Decimal  @map("default_price") @db.Decimal(12, 2)
  displayOrder            Int      @default(0) @map("display_order")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([displayOrder])
  @@map("shipping_services")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Banner {
  id              String    @id @default(uuid(7)) @db.Uuid
  title           String
  subtitle        String?   @db.Text
  description     String?   @db.Text
  desktopImageUrl String    @map("desktop_image_url")
  mobileImageUrl  String?   @map("mobile_image_url")
  redirectUrl     String?   @map("redirect_url")
  displayOrder    Int       @default(0) @map("display_order")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  isEnabled       Boolean   @default(true) @map("is_enabled")
  deletedAt       DateTime? @map("deleted_at")
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isActive, isEnabled, startDate, endDate])
  @@index([displayOrder])
  @@map("banners")
}

model Voucher {
  id                String       @id @default(uuid(7)) @db.Uuid
  code              String       @unique
  name              String
  description       String?      @db.Text
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  minPurchaseAmount Decimal      @default(0) @map("min_purchase_amount") @db.Decimal(12, 2)
  usageLimit        Int?         @map("usage_limit")
  usagePerUser      Int?         @default(1) @map("usage_per_user")
  usedCount         Int          @default(0) @map("used_count")
  startDate         DateTime     @map("start_date")
  endDate           DateTime     @map("end_date")
  isActive          Boolean      @default(true) @map("is_active")
  isEnabled         Boolean      @default(true) @map("is_enabled")
  deletedAt         DateTime?    @map("deleted_at")
  createdById       String?      @map("created_by_id") @db.Uuid
  updatedById       String?      @map("updated_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([code])
  @@index([isActive, isEnabled, startDate, endDate])
  @@map("vouchers")
}

model MarketingConfig {
  id                    String   @id @default(uuid(7)) @db.Uuid
  allowMultipleVouchers Boolean  @default(false) @map("allow_multiple_vouchers")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("marketing_configs")
}


